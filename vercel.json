{
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    { "source": "/api/(.*)",        "destination": "/api/$1" },
    { "source": "/opds/catalogue",  "destination": "/api/opds/catalogue" },
    { "source": "/opds",            "destination": "/api/opds" },
    { "source": "/(.*)",            "destination": "/index.html" }
  ]
}
